# Database (SQLite default for instant zero-config local demo; replace with Neon/PostgreSQL URL in production)
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js Secret
AUTH_SECRET="mailtracer_cyber_forensics_secure_secret_token_32chars"

# Storage (Vercel Blob in production)
BLOB_READ_WRITE_TOKEN=""

# AI Inference (Optional - if blank, system transparently uses built-in rule-based heuristics)
OPENAI_API_KEY=""

# External Threat Intelligence APIs (Optional - if blank, system displays 'Status: Not configured')
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
IPINFO_TOKEN=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Mode - Preloads synthetic cases & offline test fixtures
DEMO_MODE=true
